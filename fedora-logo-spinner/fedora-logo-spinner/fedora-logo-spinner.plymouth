[Plymouth Theme]
Name=fedora-logo-spinner
Description=Fedora theme with logo and spinner
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Cantarell 16
ImageDir=/usr/share/plymouth/themes/fedora-logo-spinner
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.5
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.55
HorizontalAlignment=.5
VerticalAlignment=.6
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.98
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.6
ProgressBarWidth=350
ProgressBarHeight=5
ProgressBarBackgroundColor=0x333333
ProgressBarForegroundColor=0x51a2da
DialogClearsFirmwareBackground=true
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=true
UseFirmwareBackground=false
ProgressBarShowPercentComplete=false
UseProgressBar=false
Title=Starting

[shutdown]
UseEndAnimation=true
UseFirmwareBackground=false
ProgressBarShowPercentComplete=false
UseProgressBar=false
Title=Shutting down

[reboot]
UseEndAnimation=true
UseFirmwareBackground=false
ProgressBarShowPercentComplete=false
UseProgressBar=false
Title=Restarting

[updates]
UseFirmwareBackground=false
SuppressMessages=true
ProgressBarShowPercentComplete=false
UseProgressBar=true
Title=Installing updates

[system-upgrade]
UseFirmwareBackground=false
SuppressMessages=true
ProgressBarShowPercentComplete=false
UseProgressBar=true
Title=Installing upgrades

[firmware-upgrade]
UseFirmwareBackground=false
SuppressMessages=true
ProgressBarShowPercentComplete=false
UseProgressBar=true
Title=Installing firmware
